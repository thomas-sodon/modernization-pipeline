APP_DIR = Path(__file__).resolve().parent.parent
SLUG = "{{ slug }}"
DB_NAME = "{{ db_name }}"
MAX_DB_NAME = 63
SERVER = "postgres://u:p@127.0.0.1:5432"
DB_NAME_EXPR = "settings.DATABASES['default']['NAME']"


def make_app(
    root: Path,
    name: str,
    *,
    feature: bool = False,
    urls: bool = False,
) -> Path:
    pkg = root / name
    pkg.mkdir(parents=True)
    (pkg / "__init__.py").write_text("", encoding="utf-8")
    lines = [
        "from django.apps import AppConfig",
        "",
        "",
        "class FakeConfig(AppConfig):",
        f"    name = {name!r}",
        f"    label = {name!r}",
    ]
    if feature:
        label = name.replace("_", " ").title()
        lines += ["    feature = True", f"    nav_label = {label!r}"]
    (pkg / "apps.py").write_text("\n".join(lines) + "\n", encoding="utf-8")
    if urls:
        (pkg / "urls.py").write_text(
            "from django.http import HttpResponse\n"
            "from django.urls import path\n\n"
            f"app_name = {name!r}\n"
            "urlpatterns = [\n"
            "    path('', lambda request: HttpResponse('ok'), name='index'),\n"
            "]\n",
            encoding="utf-8",
        )
    return pkg


# ---------------------------------------------------------------- discovery


def test_discovery_lists_every_apps_py_sorted_without_users(tmp_path):
    apps_dir = tmp_path / "fakeslug"
    for name in ("users", "orders", "core", "legacy", "inventory"):
        make_app(apps_dir, name)
    (apps_dir / "static").mkdir()
    (apps_dir / "templates").mkdir()
    assert discovery.discover_local_apps(apps_dir, {}) == [
        "fakeslug.core",
        "fakeslug.inventory",
        "fakeslug.legacy",
        "fakeslug.orders",
    ]


def test_only_areas_keeps_core_legacy_domain_and_the_named_areas(tmp_path):
    apps_dir = tmp_path / "fakeslug"
    for name in ("users", "orders", "core", "legacy", "domain", "inventory", "reports"):
        make_app(apps_dir, name)
    env = {"MP_ONLY_AREAS": "orders, reports"}
    assert discovery.discover_local_apps(apps_dir, env) == [
        "fakeslug.core",
        "fakeslug.domain",
        "fakeslug.legacy",
        "fakeslug.orders",
        "fakeslug.reports",
    ]


def test_only_areas_never_imports_another_area(tmp_path):
    apps_dir = tmp_path / "fakeslug"
    make_app(apps_dir, "orders")
    broken = apps_dir / "halfwritten"
    broken.mkdir()
    (broken / "apps.py").write_text("this is not python(\n", encoding="utf-8")
    assert discovery.discover_local_apps(apps_dir, {"MP_ONLY_AREAS": "orders"}) == [
        "fakeslug.orders",
    ]


def test_only_areas_with_an_unknown_id_raises(tmp_path):
    apps_dir = tmp_path / "fakeslug"
    make_app(apps_dir, "orders")
    with pytest.raises(ImproperlyConfigured, match="nosuch"):
        discovery.discover_local_apps(apps_dir, {"MP_ONLY_AREAS": "orders,nosuch"})


def test_empty_only_areas_means_every_area(tmp_path):
    apps_dir = tmp_path / "fakeslug"
    for name in ("orders", "inventory"):
        make_app(apps_dir, name)
    assert discovery.discover_local_apps(apps_dir, {"MP_ONLY_AREAS": " "}) == [
        "fakeslug.inventory",
        "fakeslug.orders",
    ]


def test_settings_install_users_and_the_discovered_apps():
    local = [app for app in settings.INSTALLED_APPS if app.startswith(f"{SLUG}.")]
    assert local[0] == f"{SLUG}.users"
    assert local[1:] == discovery.discover_local_apps(APP_DIR / SLUG)


