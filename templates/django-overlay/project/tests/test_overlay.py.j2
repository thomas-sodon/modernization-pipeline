# ---------------------------------------------------------------- test databases


def test_test_db_name_with_and_without_suffix():
    assert testdb.make_test_db_name(DB_NAME, "test_", "s5_x") == f"test_{DB_NAME}_s5_x"
    assert testdb.make_test_db_name(DB_NAME, "test_", "") == f"test_{DB_NAME}"


def test_prefix_and_suffix_come_from_the_environment():
    env = {"MP_TEST_DB_PREFIX": "mpdata_test_", "MP_DB_SUFFIX": "s4_probe"}
    assert testdb.prefix_and_suffix(env) == ("mpdata_test_", "s4_probe")
    assert testdb.prefix_and_suffix({}) == ("test_", "")


def test_long_test_db_names_are_cut_and_hashed():
    name = "a" * 41
    suffix = "s" * 24
    full = f"mpdata_test_{name}_{suffix}"
    cut = testdb.make_test_db_name(name, "mpdata_test_", suffix)
    assert len(full) > MAX_DB_NAME
    assert len(cut) == MAX_DB_NAME
    assert cut.startswith(f"mpdata_test_{name}_")
    assert cut.endswith("_" + hashlib.sha1(full.encode()).hexdigest()[:8])  # noqa: S324


def test_applying_the_helper_twice_gives_the_same_name():
    dbs = {"default": {"NAME": DB_NAME}}
    testdb.apply_test_db_names(dbs, "test_", "slot")
    first = dbs["default"]["TEST"]["NAME"]
    testdb.apply_test_db_names(dbs, "test_", "slot")
    assert dbs["default"]["TEST"]["NAME"] == first == f"test_{DB_NAME}_slot"


# ---------------------------------------------------------------- database settings


def test_database_url_wins_over_pg_url():
    env = {
        "DATABASE_URL": "postgres://u:p@db.example.com:5432/chosen",
        "PG_URL": "postgresql://u:p@127.0.0.1:55432",
    }
    assert database.database_settings(env, DB_NAME)["NAME"] == "chosen"


def test_pg_url_fallback_adds_the_db_name():
    env = {"PG_URL": "postgresql://u:p@127.0.0.1:55432/"}
    config = database.database_settings(env, DB_NAME)
    assert config["NAME"] == DB_NAME
    assert config["ENGINE"] == "django.db.backends.postgresql"
    assert config["HOST"] == "127.0.0.1"


def test_no_database_variable_raises_naming_both():
    with pytest.raises(ImproperlyConfigured, match="DATABASE_URL") as info:
        database.database_settings({}, DB_NAME)
    assert "PG_URL" in str(info.value)


def test_mssql_url_gets_the_python_driver_and_local_trust():
    config = database.database_config("mssql://u:p@127.0.0.1:14330/somedb")
    assert config["ENGINE"] == "mssql"
    assert config["NAME"] == "somedb"
    assert config["OPTIONS"]["python_driver"] == "mssql_python"
    assert config["OPTIONS"]["extra_params"] == "TrustServerCertificate=yes"


def test_remote_mssql_url_keeps_certificate_checks():
    config = database.database_config("mssql://u:p@sql.example.com:1433/somedb")
    assert config["OPTIONS"]["python_driver"] == "mssql_python"
    assert "extra_params" not in config["OPTIONS"]


def test_dot_env_never_overrides_the_environment(tmp_path, monkeypatch):
    dot_env = tmp_path / ".env"
    dot_env.write_text(f"DATABASE_URL={SERVER}/from_file\n", encoding="utf-8")
    monkeypatch.setenv("DATABASE_URL", f"{SERVER}/from_environment")
    environ.Env.read_env(str(dot_env), overwrite=False)
    assert os.environ["DATABASE_URL"].endswith("/from_environment")


def settings_value(expr: str, env: dict) -> str:
    code = f"from django.conf import settings; print({expr})"
    result = subprocess.run(  # noqa: S603
        [sys.executable, "-c", code],
        cwd=APP_DIR,
        env=env,
        capture_output=True,
        text=True,
        check=False,
    )
    assert result.returncode == 0, result.stderr[-2000:]
    return result.stdout.strip()


def base_env() -> dict:
    keep = ("PATH", "HOME", "LD_LIBRARY_PATH", "SYSTEMROOT")
    env = {k: v for k, v in os.environ.items() if k in keep}
    env["DJANGO_SETTINGS_MODULE"] = "config.settings.test"
    return env


def test_settings_take_database_url_from_the_environment():
    env = base_env() | {"DATABASE_URL": f"{SERVER}/from_environment"}
    assert settings_value(DB_NAME_EXPR, env) == "from_environment"


def test_test_settings_name_the_test_database_with_the_helper():
    env = base_env() | {
        "DATABASE_URL": f"{SERVER}/somedb",
        "MP_TEST_DB_PREFIX": "mpdata_test_",
        "MP_DB_SUFFIX": "s9_probe",
    }
    expr = "settings.DATABASES['default']['TEST']['NAME']"
    assert settings_value(expr, env) == "mpdata_test_somedb_s9_probe"


def test_settings_fall_back_to_pg_url_without_dot_env():
    env = base_env() | {
        "DJANGO_READ_DOT_ENV_FILE": "false",
        "PG_URL": "postgresql://u:p@127.0.0.1:55432",
    }
    assert settings_value(DB_NAME_EXPR, env) == DB_NAME


