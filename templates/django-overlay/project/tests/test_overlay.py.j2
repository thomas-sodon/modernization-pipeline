@pytest.fixture
def fake_feature_apps(tmp_path, monkeypatch):
    root = tmp_path / "fakepkgs"
    root.mkdir()
    make_app(root, "mpfake_area", feature=True, urls=True)
    make_app(root, "mpfake_nourls", feature=True)
    make_app(root, "mpfake_plain", urls=True)
    (root / "mpfake_urlconf.py").write_text(
        "from config.discovery import feature_urlpatterns\n\n"
        "urlpatterns = feature_urlpatterns()\n",
        encoding="utf-8",
    )
    monkeypatch.syspath_prepend(str(root))
    names = ["mpfake_area", "mpfake_nourls", "mpfake_plain"]
    with override_settings(
        INSTALLED_APPS=[*settings.INSTALLED_APPS, *names],
        ROOT_URLCONF="mpfake_urlconf",
    ):
        yield
    for module in list(sys.modules):
        if module.startswith("mpfake_"):
            del sys.modules[module]


