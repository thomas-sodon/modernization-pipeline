# ---------------------------------------------------------------- sites migration


class FakeCursor:
    def __init__(self, log):
        self.log = log

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        return False

    def execute(self, sql, params=None):
        self.log.append(sql)

    def fetchone(self):
        return (1,)


def run_sites_migration(vendor: str) -> list[str]:
    module = importlib.import_module(
        f"{SLUG}.contrib.sites.migrations.0003_set_site_domain_and_name",
    )
    log: list[str] = []
    site = SimpleNamespace(id=1)
    manager = SimpleNamespace(
        update_or_create=lambda **kwargs: (site, True),
        order_by=lambda *args: SimpleNamespace(first=lambda: site),
    )
    model = SimpleNamespace(objects=manager)
    connection = SimpleNamespace(vendor=vendor, cursor=lambda: FakeCursor(log))
    module._update_or_create_site_with_sequence(model, connection, "example.com", "x")  # noqa: SLF001
    return log


def test_sites_migration_touches_the_sequence_only_on_postgresql():
    assert run_sites_migration("microsoft") == []
    assert run_sites_migration("postgresql")


@pytest.mark.django_db
def test_sites_migration_sets_the_site_name():
    assert Site.objects.get(id=settings.SITE_ID).name == settings.PROJECT_NAME
