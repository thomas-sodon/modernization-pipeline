"""Entra group to role mapping, tested with a fake sociallogin (no network)."""

from __future__ import annotations

import base64
import json
from types import SimpleNamespace

import pytest
from django.contrib.auth.models import Group

from {{ slug }}.users.adapters import SocialAccountAdapter
from {{ slug }}.users.adapters import assign_entra_roles
from {{ slug }}.users.adapters import entra_group_ids
from {{ slug }}.users.adapters import roles_for_groups
from {{ slug }}.users.microsoft import id_token_claims

GROUP_SALES = "11111111-1111-4111-8111-111111111111"
GROUP_STOCK = "22222222-2222-4222-8222-222222222222"
GROUP_OTHER = "33333333-3333-4333-8333-333333333333"
MAPPING = {GROUP_SALES: "sales", GROUP_STOCK: "warehouse"}


def fake_sociallogin(user, groups, provider="microsoft"):
    return SimpleNamespace(
        user=user,
        is_existing=True,
        account=SimpleNamespace(provider=provider, extra_data={"groups": groups}),
    )


def group_names(user) -> set[str]:
    return set(user.groups.values_list("name", flat=True))


def test_roles_for_groups_ignores_unknown_ids():
    assert roles_for_groups([GROUP_OTHER, GROUP_SALES], MAPPING) == ["sales"]
    assert roles_for_groups([GROUP_OTHER], MAPPING) == []


def test_group_ids_come_from_extra_data_only_when_a_list():
    assert entra_group_ids(fake_sociallogin(None, [GROUP_SALES, 7])) == [GROUP_SALES]
    assert entra_group_ids(fake_sociallogin(None, "not-a-list")) == []


@pytest.mark.django_db
def test_signed_in_user_gets_the_groups_of_its_roles(user, settings):
    settings.ENTRA_GROUP_ROLES = MAPPING
    roles = assign_entra_roles(user, fake_sociallogin(user, [GROUP_SALES, GROUP_OTHER]))
    assert roles == ["sales"]
    assert group_names(user) == {"sales"}
    assert not Group.objects.filter(name="warehouse").exists()


@pytest.mark.django_db
def test_unknown_groups_give_no_role(user, settings):
    settings.ENTRA_GROUP_ROLES = MAPPING
    assert assign_entra_roles(user, fake_sociallogin(user, [GROUP_OTHER])) == []
    assert group_names(user) == set()


@pytest.mark.django_db
def test_a_lost_group_takes_its_role_away(user, settings):
    settings.ENTRA_GROUP_ROLES = MAPPING
    assign_entra_roles(user, fake_sociallogin(user, [GROUP_SALES, GROUP_STOCK]))
    assert group_names(user) == {"sales", "warehouse"}
    assign_entra_roles(user, fake_sociallogin(user, [GROUP_STOCK]))
    assert group_names(user) == {"warehouse"}


@pytest.mark.django_db
def test_other_providers_are_left_alone(user, settings):
    settings.ENTRA_GROUP_ROLES = MAPPING
    other = fake_sociallogin(user, [GROUP_SALES], "google")
    assert assign_entra_roles(user, other) == []
    assert group_names(user) == set()


def test_microsoft_sign_in_may_create_accounts_local_signup_may_not(rf, settings):
    settings.ACCOUNT_ALLOW_REGISTRATION = False
    adapter = SocialAccountAdapter()
    request = rf.get("/")
    assert adapter.is_open_for_signup(request, fake_sociallogin(None, [])) is True
    other = fake_sociallogin(None, [], "google")
    assert adapter.is_open_for_signup(request, other) is False


def b64(data: dict) -> str:
    raw = json.dumps(data).encode()
    return base64.urlsafe_b64encode(raw).decode().rstrip("=")


def test_id_token_claims_reads_the_groups_claim():
    jwt = ".".join([b64({"alg": "none"}), b64({"groups": [GROUP_SALES]}), "sig"])
    assert id_token_claims(jwt)["groups"] == [GROUP_SALES]


def test_id_token_claims_of_a_malformed_token_are_empty():
    assert id_token_claims(None) == {}
    assert id_token_claims("onlyonepart") == {}
    assert id_token_claims("a.%%%.c") == {}
